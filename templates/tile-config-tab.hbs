<div class="tab tile-fx-painter" data-group="{{group}}" data-tab="{{tabId}}">
  <div class="form-group">
    <label for="{{inputId}}">{{localize "TILE_FX_PAINTER.Config.Enabled.Label"}}</label>
    <div class="form-fields">
      <input type="checkbox" id="{{inputId}}" name="flags.{{moduleId}}.enabled" {{checked enabled}}>
    </div>
    <p class="hint">{{localize "TILE_FX_PAINTER.Config.Enabled.Hint"}}</p>
  </div>

  <fieldset>
    <legend>{{localize "TILE_FX_PAINTER.Config.Effect.Legend"}}</legend>

    <div class="form-group">
      <label for="{{shaderId}}">{{localize "TILE_FX_PAINTER.Config.Shader.Label"}}</label>
      <div class="form-fields">
        <select id="{{shaderId}}" name="flags.{{moduleId}}.shader">
          {{selectOptions shaderChoices selected=shader localize=true}}
        </select>
      </div>
      <p class="hint">{{localize "TILE_FX_PAINTER.Config.Shader.Hint"}}</p>
    </div>

    <div class="form-group">
      <label for="{{intensityId}}">{{localize "TILE_FX_PAINTER.Config.Intensity.Label"}}</label>
      <div class="form-fields">
        <range-picker id="{{intensityId}}" name="flags.{{moduleId}}.intensity" value="{{intensity}}" min="0" max="2" step="0.05"></range-picker>
      </div>
      <p class="hint">{{localize "TILE_FX_PAINTER.Config.Intensity.Hint"}}</p>
    </div>

    <div class="form-group">
      <label for="{{colorId}}">{{localize "TILE_FX_PAINTER.Config.Color.Label"}}</label>
      <div class="form-fields">
        <color-picker id="{{colorId}}" name="flags.{{moduleId}}.color" value="{{color}}" placeholder="{{colorPlaceholder}}"></color-picker>
      </div>
      <p class="hint">{{localize "TILE_FX_PAINTER.Config.Color.Hint"}}</p>
    </div>

    <div class="form-group">
      <label for="{{speedId}}">{{localize "TILE_FX_PAINTER.Config.Speed.Label"}}</label>
      <div class="form-fields">
        <range-picker id="{{speedId}}" name="flags.{{moduleId}}.speed" value="{{speed}}" min="0" max="3" step="0.05"></range-picker>
      </div>
      <p class="hint">{{localize "TILE_FX_PAINTER.Config.Speed.Hint"}}</p>
    </div>

    <div class="form-group">
      <label for="{{scaleId}}">{{localize "TILE_FX_PAINTER.Config.Scale.Label"}}</label>
      <div class="form-fields">
        <range-picker id="{{scaleId}}" name="flags.{{moduleId}}.scale" value="{{scale}}" min="0.25" max="4" step="0.05"></range-picker>
      </div>
      <p class="hint">{{localize "TILE_FX_PAINTER.Config.Scale.Hint"}}</p>
    </div>

    {{#if canOpenEditor}}
    <button type="button" class="tile-fx-painter-open-editor">
      <i class="fa-solid fa-pen-ruler" inert></i>
      <span>{{localize "TILE_FX_PAINTER.Config.OpenEditor.Label"}}</span>
    </button>
    {{/if}}
  </fieldset>
</div>
